<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform splash screen, with no library: the backport only adds
      setKeepOnScreenCondition, and holding the user for the animation is exactly what the
      handoff forbids. The splash leaves on Garage's first frame, whether or not the needle
      has finished its sweep.
    -->
    <style name="Theme.FuelLog.Starting">
        <item name="android:windowSplashScreenBackground">@color/brand_yellow</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
