<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a fuel gauge with the needle at full.

  Paths are verbatim from the design handoff. Stroke only, round caps and joins,
  on a 24 x 24 grid - the same construction as every other icon in the app.
  Do not recolor, rotate, or add a shadow. The needle is the only part that
  ever moves, and only on the splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dial arc -->
    <path
        android:pathData="M4.5 16.5a8 8 0 1 1 15 0"
        android:strokeColor="#0D1117"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Left tick -->
    <path
        android:pathData="M6.6 9.3 7.6 10.4"
        android:strokeColor="#0D1117"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Top tick -->
    <path
        android:pathData="M12 5.2V6.7"
        android:strokeColor="#0D1117"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Right tick -->
    <path
        android:pathData="M17.4 9.3 16.4 10.4"
        android:strokeColor="#0D1117"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Needle. Grouped and named so the splash can rotate it about the hub. -->
    <group
        android:name="needle"
        android:pivotX="12"
        android:pivotY="16.5">
        <path
            android:pathData="M12 16.5 16.2 10.8"
            android:strokeColor="#0D1117"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
    </group>

    <!-- Hub, filled -->
    <path
        android:pathData="M12 15a1.5 1.5 0 1 0 0 3 1.5 1.5 0 1 0 0 -3z"
        android:fillColor="#0D1117" />
</vector>
