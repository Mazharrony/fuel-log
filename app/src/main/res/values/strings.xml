    <!-- What this app collects -->
    <string name="collects_title">What this app collects</string>
    <string name="collects_lead">Nothing about you. No internet permission, no account, no ads, no analytics.</string>
    <string name="collects_stored_heading">What it stores</string>
    <string name="collects_stored_body">Your vehicles, fill-ups, expenses and reminders, and a handful of settings. They live in the app\'s private storage on this phone.</string>
    <string name="collects_backup_heading">Android\'s own backup</string>
    <string name="collects_backup_body">If Android backup is on for this phone, Android copies the app\'s data to your Google account, as it does for other apps. On Android 9 and later that copy is end-to-end encrypted with your screen lock, so Google cannot read it. You can turn it off in the phone\'s settings.</string>
    <string name="collects_permissions_heading">Permissions</string>
    <string name="collects_permissions_body">Notifications, asked for only when you turn reminders on. Run at startup, used only to set reminders again after the phone restarts. Nothing else - check the permission list in the phone\'s app settings.</string>
    <string name="collects_not_heading">What it does not do</string>
    <string name="collects_not_body">No ads, no analytics, no crash reporting, no location, no contacts, no camera.</string>
    <string name="collects_delete_heading">Deleting your data</string>
    <string name="collects_delete_body">Delete a vehicle to remove it and all its entries, or uninstall the app to remove everything. CSV exports and backups you saved are files you control.</string>
    <string name="collects_licences_heading">Open-source licences</string>
    <string name="collects_licences_body">Instrument Sans, copyright 2022 The Instrument Sans Project Authors, used under the SIL Open Font License 1.1.</string>

