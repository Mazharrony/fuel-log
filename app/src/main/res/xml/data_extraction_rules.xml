    <device-transfer>
        <include domain="database" path="fuel-log.db" />
        <include domain="database" path="fuel-log.db-wal" />
        <include domain="database" path="fuel-log.db-shm" />
        <include domain="sharedpref" path="fuel-log-settings.xml" />
    </device-transfer>
</data-extraction-rules>
